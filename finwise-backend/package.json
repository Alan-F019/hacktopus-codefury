{
  "name": "finwise-backend",
  "version": "1.0.0",
  "description": "Production-grade backend API for FinWise personal financial health dashboard",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --config jest.config.cjs --runInBand --detectOpenHandles",
    "test:coverage": "jest --config jest.config.cjs --coverage --runInBand",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.7.0",
    "mongodb": "^7.5.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.5.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.10",
    "@types/papaparse": "^5.3.15",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
